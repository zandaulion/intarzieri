[Unit]
Description=Romanian train delay API (polls the public live map)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/train-api:latest
ContainerName=train-api
# Loopback only: reachable through Caddy, never directly from the network.
PublishPort=127.0.0.1:8091:8000
# How often watched trains are re-checked for departure/delay/arrival.
# Deliberately unhurried: a delay that moves inside five minutes is not worth
# a request, and this is the app's only load on the source.
Environment=WATCH_SECONDS=300
# Minimum change in minutes before a delay is worth a notification.
Environment=DELAY_THRESHOLD=5
Environment=VAPID_SUBJECT=@VAPID_SUBJECT@
# Substituted from site.env at deploy time, so the repo carries no
# site-specific values. See site.env.example.
Environment=PUBLIC_BASE_URL=@PUBLIC_BASE_URL@
Environment=INVITE_TTL_DAYS=7
# Grace period after an invite's first use during which it re-binds the same
# device instead of being spent. Covers "tapped it in WhatsApp, then installed
# the app properly" without leaving the link live for a week.
Environment=INVITE_REBIND_MINUTES=60
# Outage alerts. Substituted from site.env at deploy time.
Environment=NTFY_TOPIC=@NTFY_TOPIC@
# VAPID keypair + subscription database. Named volume so a rebuild of the
# image never destroys existing push subscriptions.
Volume=train-api-data:/data
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
