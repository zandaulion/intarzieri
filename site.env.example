# Site-specific values. Copy to site.env (which is gitignored) and fill in.
# Kept out of the repository so a public clone carries no infrastructure
# details -- the code is generic, only this file knows where it runs.

# Public origin the app is served from. Used to render invite links.
PUBLIC_BASE_URL=https://trains.example.com

# Contact address embedded in VAPID push claims, per RFC 8292.
VAPID_SUBJECT=mailto:you@example.com

# Base URL of the tailnet-only admin surface, used by ./admin.sh.
ADMIN_API=http://<tailnet-address>
