FROM docker.io/library/python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY iris.py route.py trips.py push.py app.py stations.json ./

# Run unprivileged inside the container as well as rootless outside it.
RUN useradd --system --uid 10001 --no-create-home appuser \
 && mkdir -p /data && chown 10001:10001 /data

# VAPID keypair and trip subscriptions live here. It must be a volume: losing
# the keypair silently invalidates every browser subscription already issued.
VOLUME /data
ENV DATA_DIR=/data

USER 10001

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
